# Copy this file to .env on the Linux CPU host before running:
# docker compose --env-file deploy/taskdroid.prod.env -f deploy/docker-compose.taskdroid.yml up -d

TASKDROID_API_IMAGE=ghcr.io/14121994/task-droid-ai:main
TASKDROID_VLLM_IMAGE=vllm/vllm-openai-cpu:latest-x86_64
TASKDROID_VLLM_SHM_SIZE=4g

TASKDROID_API_HOST_PORT=8000
TASKDROID_VLLM_HOST_PORT=8001

MODEL_ALIAS=taskdroid-android-planner-v1
MODEL_NAME=openai/gpt-oss-20b
VLLM_MAX_MODEL_LEN=65536
VLLM_DTYPE=bfloat16
VLLM_CPU_KVCACHE_SPACE=16
VLLM_CPU_NUM_OF_RESERVED_CPU=1
# Optional CPU thread binding, for example: VLLM_CPU_OMP_THREADS_BIND=0-15
VLLM_EXTRA_ARGS=

PLANNER_VLLM_TIMEOUT_SECONDS=120
PLANNER_VLLM_COMPLETION_MAX_TOKENS=2048
PLANNER_VLLM_RESPONSE_FORMAT_JSON=1
PLANNER_PRIMARY_RETRIES=1
PLANNER_HEALTH_GENERATION_PROBE=1
PLANNER_HEALTH_PROBE_TIMEOUT_SECONDS=5

# Optional for gated/private model pulls.
HUGGING_FACE_HUB_TOKEN=
